# Скопируйте в .env и заполните. .env в git не попадает.

# токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram id администратора: бот пришлёт его в ответ на любую команду
TGBOT_ADMIN=
# адрес Web UI для ссылок входа, которые присылает бот по /login
TGBOT_PUBLIC_URL=http://localhost:8080

DB_USER=tgbot
DB_PASSWORD=tgbot

# навык «чеки»
OLLAMA_BASE_URL=http://192.168.1.224:11434
TGBOT_RECEIPT_ENABLED=true
